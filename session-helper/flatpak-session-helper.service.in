[Unit]
Description=flatpak session helper
PartOf=graphical-session.target

[Service]
BusName=org.freedesktop.Flatpak
ExecStart=@libexecdir@/flatpak-session-helper
Type=dbus

# No hardening: the useful options (ProtectHome, PrivateNetwork, etc.)
# cannot be used because mount namespaces and seccomp filters are inherited
# by arbitrary host commands spawned via Development.HostCommand. The options
# that could safely be enabled (ProtectKernel*, ProtectClock, etc.) only
# restrict operations that already require root capabilities.
